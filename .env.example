# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...          # anon / public key (safe to expose)
SUPABASE_SERVICE_ROLE_KEY=eyJ...              # service_role key (NEVER expose client-side)

# ─── App URL ──────────────────────────────────────────────────────────────────
# In development: http://localhost:3000
# In production:  https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ─── Resend (email) ───────────────────────────────────────────────────────────
# Found in: resend.com → API Keys
RESEND_API_KEY=re_...

# ─── Upstash Redis (rate limiting) ────────────────────────────────────────────
# Found in: console.upstash.com → Database → REST API
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ─── Vercel Cron security ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Must match what Vercel sends as "Authorization: Bearer <value>"
CRON_SECRET=your-random-secret-here

# ─── Paddle (billing) ─────────────────────────────────────────────────────────
# Found in: vendors.paddle.com → Developer Tools → Authentication
PADDLE_API_KEY=...
PADDLE_WEBHOOK_SECRET=...
# Price IDs from your Paddle product catalog
PADDLE_PRICE_STARTER=pri_...
PADDLE_PRICE_PRO=pri_...
PADDLE_PRICE_GROWTH=pri_...

# ─── (LEGACY — only if using Stripe instead of Paddle) ───────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_GROWTH=price_...
